{
  "name": "zuojia-desktop",
  "productName": "作家",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "ZUOJIA_RENDERER_MODE=development bash scripts/dev.sh",
    "dev:node": "ZUOJIA_RENDERER_MODE=development node scripts/dev-launcher.js",
    "dev:old": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "start": "ZUOJIA_RENDERER_MODE=production electron .",
    "build": "vite build",
    "package:mac": "rm -rf dist/mac-arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --mac dmg --publish never",
    "release:mac:local": "bash scripts/release-mac-local.sh",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --run tests/integration",
    "test:e2e": "ZUOJIA_RENDERER_MODE=production npm run build && playwright test",
    "test:e2e:ui": "ZUOJIA_RENDERER_MODE=production npm run build && playwright test --ui",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@testing-library/dom": "^10.4.1",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dompurify": "^3.0.8",
    "marked": "^12.0.2",
    "neo4j-driver": "^5.28.3",
    "nspell": "^2.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^8.0.0",
    "electron": "^40.10.6",
    "jsdom": "^23.0.0",
    "playwright": "^1.40.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.dominickua.zuojia",
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "index.html",
          "assets/**",
          "dictionary-en/**",
          "dictionary-en-gb/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "zuojia-v${version}-${arch}.${ext}"
    }
  }
}
